# ======== GEMINI ========
# Passo 1 do guia: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_aqui
# Modelo (1.5 e 2.5 Flash foram aposentados pelo Google para chaves novas)
GEMINI_MODEL=gemini-3.6-flash
# Modelos Gemini reserva (em ordem). No nível gratuito a cota diária é POR MODELO (ex.: 20 pedidos/dia cada), então a
# cadeia inteira soma as cotas. Cota diária estourada = modelo fora até o reset (meia-noite no Pacífico, 4h-5h em Brasília).
GEMINI_MODELOS_RESERVA=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# Modelos leves (Flash Lite: 500 pedidos/dia cada no nível gratuito) pra papo, extração de dados, notas, rotina e cobrança
GEMINI_MODELOS_LEVES=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# ======== IAs RESERVA (opcionais; entram só quando todos os Gemini falham) ========
# Groq (texto, rápido): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Hugging Face (texto + FOTO): https://huggingface.co/settings/tokens (token de leitura basta)
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_VISAO=google/gemma-3-27b-it
# Cohere (texto + foto, trial 1.000 chamadas/mês): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ======== MONGODB ATLAS ========
# Passo 2 do guia. Troque <password> pela senha do usuário do banco.
MONGODB_URI=mongodb+srv://usuario:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nutribot

# ======== GOOGLE DRIVE ========
# Passo 3 do guia. Service Account NAO grava em Drive pessoal: use o drive-oauth.json (guia 3.2/3.3). ID da pasta = parte final da URL da pasta no Drive (.../folders/ESTE_ID)
DRIVE_FOLDER_ID=cole_aqui
# Opção A (recomendada no Render): cole o CONTEÚDO inteiro do drive-oauth.json em uma linha
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opção B: caminho do arquivo JSON (local ou "Secret File" do Render)
GOOGLE_SERVICE_ACCOUNT_FILE=./drive-oauth.json

# ======== WHATSAPP ========
# ⚠️ Escaneie o QR com o NÚMERO DO BOT (eSIM), nunca com o seu número pessoal: cliente não oficial = risco de banimento.
# Deixe vazio na 1ª vez. Mande "!id" no grupo, copie o ID que o bot responder e cole aqui.
ALLOWED_GROUP_ID=
# true = manda os [[colchetes]] no WhatsApp também; false = vira *negrito* no zap (Drive sempre mantém [[ ]])
MANTER_COLCHETES_NO_ZAP=false

# ======== ADMIN / ANTI-SLEEP ========
# Senha das rotas /status?token= e /logout?token= (trocar de número sem redeploy). Invente algo longo.
ADMIN_TOKEN=
# Anti-sleep: no Render a URL pública vem sozinha (RENDER_EXTERNAL_URL). Em outro host, cole a URL aqui.
KEEPALIVE_URL=
# Intervalo do auto-ping em minutos (Render free dorme com 15 min sem tráfego)
KEEPALIVE_MINUTES=10

# ======== COMPORTAMENTO ========
# Papo aleatório entre os membros: ela entra no máximo 1x a cada N minutos (foto, pergunta, menção e assunto dela sempre respondem)
PAPO_INTERVALO_MIN=10
# Cobrança de refeição: minutos de tolerância depois do horário aprendido, e por quanto tempo ainda cobra
ATRASO_COBRANCA_MIN=75
JANELA_COBRANCA_MIN=120

# ======== GERAL ========
TZ=America/Sao_Paulo
PORT=3000
LOG_LEVEL=warn
