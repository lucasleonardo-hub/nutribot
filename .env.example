# ======== GEMINI ========
# Passo 1 do guia: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_aqui
# Chaves extras de OUTROS projetos/contas Google (separadas por vírgula): cada uma soma a própria cota gratuita.
# O bot reveza: esgotou a chave 1 num modelo, tenta a chave 2 nele antes de descer na cadeia.
GEMINI_API_KEYS=
# Modelo (1.5 e 2.5 Flash foram aposentados pelo Google para chaves novas)
GEMINI_MODEL=gemini-3.6-flash
# Modelos Gemini reserva (em ordem). No nível gratuito a cota diária é POR MODELO (ex.: 20 pedidos/dia cada), então a
# cadeia inteira soma as cotas. Cota diária estourada = modelo fora até o reset (meia-noite no Pacífico, 4h-5h em Brasília).
GEMINI_MODELOS_RESERVA=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview
# Modelos leves (Flash Lite: 500 pedidos/dia cada no nível gratuito) pra papo, extração de dados, notas, rotina e cobrança
GEMINI_MODELOS_LEVES=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# ======== IAs RESERVA (opcionais; entram só quando todos os Gemini falham) ========
# Groq (texto, rápido): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Hugging Face (texto + FOTO): https://huggingface.co/settings/tokens (token de leitura basta)
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_VISAO=google/gemma-3-27b-it
# Cohere (texto + foto, trial 1.000 chamadas/mês): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# OpenRouter (dezenas de modelos; os ":free" custam zero, 50 pedidos/dia no total): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ======== MONGODB ATLAS ========
# Passo 2 do guia. Troque <password> pela senha do usuário do banco.
MONGODB_URI=mongodb+srv://usuario:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nutribot

# ======== GOOGLE DRIVE ========
# Passo 3 do guia. Service Account NAO grava em Drive pessoal: use o drive-oauth.json (guia 3.2/3.3). ID da pasta = parte final da URL da pasta no Drive (.../folders/ESTE_ID)
DRIVE_FOLDER_ID=cole_aqui
# Opção A (recomendada no Render): cole o CONTEÚDO inteiro do drive-oauth.json em uma linha
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opção B: caminho do arquivo JSON (local ou "Secret File" do Render)
GOOGLE_SERVICE_ACCOUNT_FILE=./drive-oauth.json

# ======== WHATSAPP ========
# ⚠️ Escaneie o QR com o NÚMERO DO BOT (eSIM), nunca com o seu número pessoal: cliente não oficial = risco de banimento.
# Deixe vazio na 1ª vez. Mande "!id" no grupo, copie o ID que o bot responder e cole aqui.
ALLOWED_GROUP_ID=
# true = manda os [[colchetes]] no WhatsApp também; false = vira *negrito* no zap (Drive sempre mantém [[ ]])
MANTER_COLCHETES_NO_ZAP=false

# ======== ADMIN / ANTI-SLEEP ========
# Senha das rotas /status?token= e /logout?token= (trocar de número sem redeploy). Invente algo longo.
ADMIN_TOKEN=
# Seu WhatsApp pessoal (número com DDI + @s.whatsapp.net) pra receber avisos técnicos: reconexão longa, IA fora, cotas
ADMIN_JID=
# Anti-sleep: no Render a URL pública vem sozinha (RENDER_EXTERNAL_URL). Em outro host, cole a URL aqui.
KEEPALIVE_URL=
# Intervalo do auto-ping em minutos (Render free dorme com 15 min sem tráfego)
KEEPALIVE_MINUTES=10

# ======== COMPORTAMENTO ========
# Papo aleatório entre os membros: ela entra no máximo 1x a cada N minutos (foto, pergunta, menção e assunto dela sempre respondem)
PAPO_INTERVALO_MIN=10
# Cobrança de refeição: minutos de tolerância depois do horário aprendido, e por quanto tempo ainda cobra
ATRASO_COBRANCA_MIN=75
JANELA_COBRANCA_MIN=120

# ======== GERAL ========
TZ=America/Sao_Paulo
PORT=3000
LOG_LEVEL=warn

# ======== IDENTIDADE DA BOT (cópias do projeto preenchem aqui) ========
# Nome padrão dela antes de o grupo escolher um (o grupo pode rebatizar com !nome). Vazio = "Nutri".
BOT_NOME=
# Persona: escreva um persona.md na raiz (modelo em skill-copiar-bot/persona.template.md) ou aponte outro caminho aqui.
# Sem o arquivo, vale a persona padrão embutida em gemini.js.
PERSONA_ARQUIVO=./persona.md
# Quem responde pelo bot nas páginas públicas / e política de privacidade (o Google exige as duas pra publicar o app OAuth).
CONTATO_NOME=
CONTATO_EMAIL=
# Endereço do SEU repositório (vai no User-Agent das pesquisas e no cabeçalho do OpenRouter). Opcional.
REPO_URL=
# Palavras extras que marcam agenda ou evento de trabalho (nome da empresa etc.), separadas por vírgula. Opcional.
AGENDA_PALAVRAS_TRABALHO=

# Voz da Nutri. Motor principal: TTS do Gemini (grátis, mesmas chaves acima), com instrução de estilo no personagem.
# VOZ_GEMINI_VOZ: Sulafat (calorosa, padrão), Leda (jovem), Aoede (leve), Zephyr (viva), Laomedeia (animada), Kore (firme).
# VOZ_MOTOR=edge força a reserva (leitor do Microsoft Edge, voz VOZ_TTS), que também entra sozinha se o Gemini falhar.
VOZ_MOTOR=gemini
VOZ_GEMINI_VOZ=Sulafat
VOZ_GEMINI_MODELOS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
# VOZ_ESTILO=Fale em português do Brasil... (instrução de estilo; o padrão já descreve a personagem)
VOZ_TTS=pt-BR-FranciscaNeural
# Gráficos (QuickChart, grátis) e memória semântica (score mínimo de parecença, 0-1). Opcionais.
QUICKCHART_URL=https://quickchart.io/chart
MEMORIA_SCORE_MIN=0.74

# Conferência por amostragem do que saiu por reserva externa (quantas por semana, intervalo mínimo em horas, chance por hora)
REVISOES_POR_SEMANA=2
REVISAO_GAP_H=20
REVISAO_CHANCE=0.2

# Fotos seguidas da mesma pessoa viram UMA análise (teto por análise e janela em segundos)
MAX_FOTOS_JUNTAS=6
JANELA_FOTOS_S=300

# Treino de força pela API do Hevy (precisa de Hevy Pro; chave em hevy.com/settings?developer).
# Uma chave por pessoa, pelo primeiro nome: HEVY_CHAVES="ana=xxxx,joao=yyyy"
HEVY_CHAVES=
HEVY_SYNC_MIN=60

# Google Agenda (mesma conta do Drive; precisa reautorizar com o escopo calendar.readonly).
# Primeiro nome de quem é dono da agenda: ela só comenta a agenda COM essa pessoa.
AGENDA_DONO=
AGENDA_CACHE_MIN=15
# Caminho mais simples (sem OAuth, sem app publicado): "endereco secreto no formato iCal" da agenda
# (Google Agenda > Configuracoes da agenda > Integrar agenda > Endereco secreto no formato iCal). Trate como segredo.
AGENDA_ICS_URL=

# Tempo e estação do ano por cidade (Open-Meteo, grátis, sem chave). Só o cache em minutos é configurável.
CLIMA_CACHE_MIN=30
